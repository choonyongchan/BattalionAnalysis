{
  "name": "battalion-data-analysis",
  "private": true,
  "type": "module",
  "workspaces": ["frontend", "backend", "runner"],
  "scripts": {
    "dev": "bun run --cwd frontend dev",
    "dev:api": "bun --env-file=.env.test test/support/devServer.ts",
    "build": "bun run --cwd frontend build",
    "test": "bun test ./test/",
    "test:coverage": "bun test ./test/ --coverage",
    "typecheck": "tsc -p .",
    "db:generate": "bun run --cwd backend db:generate",
    "db:migrate": "bun --env-file=.env.local backend/scripts/apply-migrations.ts",
    "runner": "bun --env-file=.env.whatsapp runner/src/supervisor.js",
    "runner:bridge": "bun --env-file=.env.whatsapp runner/src/index.js",
    "runner:reset-auth": "bun runner/scripts/reset-auth.js",
    "runner:service": "bun runner/scripts/service.js"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^5.7.0"
  }
}
