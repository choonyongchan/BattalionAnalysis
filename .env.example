# Copy to .env.local (never committed). On Vercel, set these in
# Project Settings -> Environment Variables.

# --- Database -------------------------------------------------------------
# Neon Postgres. The read-only role is denied SELECT on raw_messages.body, so a
# bug in the dashboard route cannot return parade-state free text.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_READONLY=postgresql://dashboard_reader:password@host/db?sslmode=require

# --- Parade-state intake --------------------------------------------------
# Shared secret the local WhatsApp bridge sends in its POST body. Must match the
# bridge's INGEST_TOKEN. The route fails closed when this is unset.
WHATSAPP_INGEST_TOKEN=

# Secret the Vercel Cron drain presents so the parse endpoint cannot be triggered
# by anyone who knows the URL.
CRON_SECRET=

# --- Parser ---------------------------------------------------------------
OPENAI_API_KEY=

# --- FormSG ---------------------------------------------------------------
# We decrypt submissions ourselves; Plumber is no longer in the path.
# FORMSG_POST_URI must byte-match the webhook URI registered in FormSG. It is
# pinned explicitly rather than derived from VERCEL_URL, because preview
# deployments get different hostnames and would fail signature checks.
FORMSG_SECRET_KEY=
FORMSG_POST_URI=https://your-app.vercel.app/api/formsg

# --- Dashboard ------------------------------------------------------------
# Single shared password. The route fails closed when this is unset.
DASHBOARD_PASSWORD=
