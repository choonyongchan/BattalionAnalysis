# Copy to .env.local (never committed). On Vercel, set these in
# Project Settings -> Environment Variables.

# --- Database -------------------------------------------------------------
# Neon Postgres, owner role (migrations, the FormSG webhook and the parade intake).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- FormSG ---------------------------------------------------------------
# We decrypt submissions ourselves; Plumber is no longer in the path.
# FORMSG_POST_URI must byte-match the webhook URI registered in FormSG. It is
# pinned explicitly rather than derived from VERCEL_URL, because preview
# deployments get different hostnames and would fail signature checks.
FORMSG_SECRET_KEY=
FORMSG_POST_URI=https://your-app.vercel.app/api/formsg

# --- Dashboard ------------------------------------------------------------
# The password the dashboard unlocks with; /api/dashboard and /api/parade both check it.
# Long; neither route has a lockout.
DASHBOARD_PASSWORD=
# The read-only dashboard_read role, printed by:
#   bun --env-file=.env.local scripts/apply-grants.ts db/grants-dashboard.sql
DASHBOARD_DATABASE_URL=

# --- Parade intake ---------------------------------------------------------
# Shared with the WhatsApp bridge (.env.whatsapp). It may only POST to /api/parade.
PARADE_INGEST_SECRET=
