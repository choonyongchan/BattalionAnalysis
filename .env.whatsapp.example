# WhatsApp bridge settings. Copy to .env.whatsapp (git-ignored) and fill in.
# Kept apart from .env.local on purpose: the bridge holds no database credentials, and
# .env.local's owner DATABASE_URL must never reach it.

# --- WhatsApp ---------------------------------------------------------------
# JID of the parade-state group, e.g. 120363001234567890@g.us
#
# To find it: leave this blank, set LOG_LEVEL=debug, and run `bun run whatsapp`. The
# listener then accepts every chat and logs each message's remoteJid, so posting
# once in the target group reveals its JID. Fill it in and restart.
WA_GROUP_ID=

# --- Intake ----------------------------------------------------------------
# The Vercel route that stores and parses parade states.
PARADE_API_URL=https://40sar.vercel.app/api/parade
# Shared with Vercel's PARADE_INGEST_SECRET. Long and random; the route has no lockout.
PARADE_INGEST_SECRET=

# --- Runtime ----------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info

# Set to 1 to log accepted messages instead of relaying them.
DRY_RUN=0
