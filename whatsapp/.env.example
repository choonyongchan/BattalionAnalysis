# Copy to .env and fill in. Never commit .env — it is git-ignored.

# --- WhatsApp ---------------------------------------------------------------
# JID of the parade-state group, e.g. 120363001234567890@g.us
#
# To find it: leave this blank, set LOG_LEVEL=debug, and run `bun start`. The
# listener then accepts every chat and logs each message's remoteJid, so posting
# once in the target group reveals its JID. Fill it in and restart.
WA_GROUP_ID=

# --- Neon -------------------------------------------------------------------
# Connection string for the parade_ingest role (db/grants-ingest.sql), NOT the
# owner. That role can store and parse parade states and nothing else.
DATABASE_URL=

# --- Parser -----------------------------------------------------------------
OPENAI_API_KEY=
# Optional. Leave blank for lib/parser/extract.ts's default.
OPENAI_MODEL=

# How often to retry messages whose parse failed transiently, in ms. A new
# message is parsed as soon as it arrives; this only sweeps leftovers.
PARSE_INTERVAL_MS=300000

# --- Runtime ----------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info

# Set to 1 to log accepted messages instead of storing them.
DRY_RUN=0
