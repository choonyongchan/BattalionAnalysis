# Migration files are hashed byte-for-byte into drizzle.__drizzle_migrations
# (scripts/apply-migrations.ts). Line-ending conversion on checkout changes the hash and
# makes an applied migration look pending, so checkouts must reproduce the applied bytes.
db/migrations/*.sql -text
# 0001 was applied from a CRLF checkout: its recorded hash is of the CRLF bytes.
db/migrations/0001_dashboard_settings.sql text eol=crlf
